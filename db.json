  "recetas": [
    {
      "id": 1,
      "title": "Sopa de Verduras",
      "Pasos": {
        "1": "Lavar y pelar las verduras.",
        "2": "Hervir a fuego lento por 40 minutos.",
        "3": "Licuar todo hasta obtener una sopa suave."
      },
      "imagen": "./src/assets/recetas-img/sopa-zapallo.png",
      "idDificultad": 1
    },
    {
      "id": 2,
      "title": "Ensalada Clásica",
      "Pasos": {
        "1": "Lavar la lechuga y el tomate.",
        "2": "Cortar el tomate en rodajas y la cebolla en pluma fina.",
        "3": "Mezclar todo en un bol y aderezar."
      },
      "imagen": "./src/assets/recetas-img/ensalada-clasica.jpg",
      "idDificultad": 1
    },
    {
      "id": 3,
      "title": "Licuado de Banana y Frutilla",
      "Pasos": {
        "1": "Lavar las frutillas y pelar las bananas.",
        "2": "Colocar la fruta en la licuadora con leche o agua y hielo.",
        "3": "Licuar hasta obtener una mezcla homogénea."
      },
      "imagen": "./src/assets/recetas-img/licuada-bananaFrutilla.jpg",
      "idDificultad": 1
    },
    {
      "id": 4,
      "title": "Ensalada de Frutas",
      "Pasos": {
        "1": "Lavar y pelar toda la fruta.",
        "2": "Cortar en dados pequeños y mezclar en un bol.",
        "3": "Añadir jugo de naranja y dejar enfriar."
      },
      "imagen": "./src/assets/recetas-img/ensalada de frutas.jpg",
      "idDificultad": 1
    },
    {
      "id": 5,
      "title": "Guacamole",
      "Pasos": {
        "1": "Pelar la palta y pisarla con un tenedor.",
        "2": "Picar cebolla y tomate muy finos y agregar a la palta.",
        "3": "Exprimir jugo de limón, salar y mezclar."
      },
      "imagen": "./src/assets/recetas-img/guacamole.jpg",
      "idDificultad": 1
    },
    {
      "id": 6,
      "title": "Jugo de Naranja y Zanahoria",
      "Pasos": {
        "1": "Pelar la zanahoria y exprimir las naranjas.",
        "2": "Licuar el jugo de naranja con la zanahoria.",
        "3": "Colar si se prefiere y servir con hielo."
      },
      "imagen": "./src/assets/recetas-img/jugo-naranjazanahoria.jpg",
      "idDificultad": 1
    },
    {
      "id": 7,
      "title": "Gazpacho Frío",
      "Pasos": {
        "1": "Lavar tomates y morrón. Pelar ajo y cebolla.",
        "2": "Triturar todo junto con agua, aceite y sal.",
        "3": "Enfriar en la heladera por al menos 2 horas antes de servir."
      },
      "imagen": "./src/assets/recetas-img/tomate-redondo.png",
      "idDificultad": 2
    },
    {
      "id": 8,
      "title": "Papas Rústicas al Horno",
      "Pasos": {
        "1": "Lavar bien las papas dejando la cáscara.",
        "2": "Cortar en gajos y mezclar con aceite y ajo picado.",
        "3": "Hornear a 200 grados hasta que estén doradas."
      },
      "imagen": "./src/assets/recetas-img/papa-negra.png",
      "idDificultad": 1
    },
    {
      "id": 9,
      "title": "Ensalada de Tomate y Palta",
      "Pasos": {
        "1": "Cortar el tomate en cubos y la palta en trozos medianos.",
        "2": "Mezclar suavemente para no romper la palta.",
        "3": "Aderezar con jugo de limón, aceite de oliva y sal."
      },
      "imagen": "./src/assets/recetas-img/ensalada.png",
      "idDificultad": 1
    },
    {
      "id": 10,
      "title": "Tarta de Verduras",
      "Pasos": {
        "1": "Preparar la masa o usar una comprada.",
        "2": "Saltear verduras variadas.",
        "3": "Rellenar y hornear 40 minutos."
      },
      "imagen": "./src/assets/recetas-img/tarta-verduras.png",
      "idDificultad": 2
    },
    {
      "id": 11,
      "title": "Brochetas de Frutas",
      "Pasos": {
        "1": "Lavar y cortar frutas de temporada en cubos.",
        "2": "Ensartar alternando colores en palillos largos.",
        "3": "Servir con yogur o miel."
      },
      "imagen": "./src/assets/recetas-img/frutas.png",
      "idDificultad": 1
    },
    {
      "id": 12,
      "title": "Jugo Verde Detox",
      "Pasos": {
        "1": "Lavar hojas verdes, manzana y pepino.",
        "2": "Licuar todo con agua y un poco de jengibre.",
        "3": "Servir frío en el desayuno."
      },
      "imagen": "./src/assets/recetas-img/frutas-y-verduras.png",
      "idDificultad": 1
    }
  ],
