      "id": 1,
      "nombre": "Sopa de Verduras",
      "pasos": [
        "Pelar y cortar la papa, zanahoria, cebolla y zapallo en cubos.",
        "Rehogar la cebolla con un poco de aceite.",
        "Agregar el resto de las verduras y cubrir con caldo o agua.",
        "Cocinar a fuego medio por 40 minutos.",
        "Licuar o pisar según preferencia."
      ],
      "duracion": "50 minutos",
      "dificultad": "Fácil",
      "cantidadPersonas": 4,
      "calorias": 120
    },
    {
      "id": 2,
      "nombre": "Ensalada Clásica Mixta",
      "pasos": [
        "Lavar bien la lechuga y los tomates.",
        "Cortar los tomates en gajos y la cebolla en pluma.",
        "Trozar la lechuga con las manos.",
        "Mezclar los ingredientes y condimentar con aceite, sal y limón."
      ],
      "duracion": "15 minutos",
      "dificultad": "Muy Fácil",
      "cantidadPersonas": 2,
      "calorias": 80
    },
    {
      "id": 3,
      "nombre": "Licuado de Banana y Frutilla",
      "pasos": [
        "Lavar las frutillas y quitarles el cabito.",
        "Pelar las bananas y cortarlas en rodajas.",
        "Colocar la fruta en la licuadora con agua o leche y hielo.",
        "Licuar hasta obtener una mezcla homogénea y servir bien frío."
      ],
      "duracion": "10 minutos",
      "dificultad": "Muy Fácil",
      "cantidadPersonas": 2,
      "calorias": 150
    },
    {
      "id": 4,
      "nombre": "Ensalada de Frutas de Verano",
      "pasos": [
        "Lavar y pelar la manzana, bananas y naranjas.",
        "Lavar las frutillas y uvas.",
        "Cortar todas las frutas en cubos o trozos pequeños.",
        "Mezclar todo en un bol grande y agregar jugo de naranja para que no se oxide.",
        "Llevar a la heladera antes de servir."
      ],
      "duracion": "20 minutos",
      "dificultad": "Fácil",
      "cantidadPersonas": 4,
      "calorias": 110
    },
    {
      "id": 5,
      "nombre": "Guacamole Fresco",
      "pasos": [
        "Pelar las paltas y pisarlas con un tenedor dejando algunos trozos.",
        "Picar finamente el tomate, la cebolla y el ajo.",
        "Mezclar la palta con los vegetales picados.",
        "Agregar el jugo de limón, sal y mezclar bien."
      ],
      "duracion": "15 minutos",
      "dificultad": "Fácil",
      "cantidadPersonas": 4,
      "calorias": 180
    },
    {
      "id": 6,
      "nombre": "Jugo de Naranja y Zanahoria",
      "pasos": [
        "Exprimir las naranjas para obtener el jugo.",
        "Pelar las zanahorias y rallarlas o cortarlas muy pequeñas.",
        "Licuar el jugo de naranja junto con la zanahoria.",
        "Colar si se desea menos pulpa, o servir directamente con hielo."
      ],
      "duracion": "10 minutos",
      "dificultad": "Fácil",
      "cantidadPersonas": 2,
      "calorias": 90
    },
    {
      "id": 7,
      "nombre": "Gazpacho Frío",
      "pasos": [
        "Lavar los tomates y el morrón. Pelar la cebolla y el ajo.",
